# =========================
# CMake 编译输出目录
# =========================
/build/
/cmake-build-*/

# 如果曾在源码目录中运行 CMake，忽略这些生成文件
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
/Makefile

# 本机专用的 CMake 配置
CMakeUserPresets.json

# =========================
# STM32 / C / C++ 编译产物
# =========================
*.o
*.obj
*.d
*.a
*.elf
*.axf
*.hex
*.bin
*.map
*.lst

# =========================
# 编辑器本地配置
# =========================
/.vscode/

# =========================
# 日志和临时文件
# =========================
*.log
*.tmp
*.bak
*~

# =========================
# Windows / macOS 系统文件
# =========================
Thumbs.db
Desktop.ini
.DS_Store

# =========================
# 本地敏感配置
# =========================
.env
.env.*
!.env.example