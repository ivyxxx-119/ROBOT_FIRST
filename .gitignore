# ==========================================
# STM32 + CMake 项目忽略规则
# ==========================================

# 编译输出目录（仅项目根目录）
/build/
/cmake-build-*/

# CMake 自动生成文件
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json

# 在项目根目录运行 CMake 时生成的 Makefile / Ninja 文件
/Makefile
/build.ninja
/rules.ninja
/.ninja_deps
/.ninja_log

# 个人 CMake 配置
# 注意：CMakePresets.json 应保留并提交
CMakeUserPresets.json

# ==========================================
# C / C++ 编译产物和 STM32 固件输出
# 如果项目包含必须提交的预编译库或二进制资源，
# 请为它们添加例外规则，或删除相应规则
# ==========================================
*.o
*.obj
*.d
*.a
*.elf
*.axf
*.hex
*.bin
*.map
*.lst

# ==========================================
# 本机编辑器配置
# 默认不提交 VS Code 配置
# ==========================================
/.vscode/

# ==========================================
# 临时文件、备份和日志
# ==========================================
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ==========================================
# 操作系统生成文件
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# 本地环境配置
# ==========================================
.env
.env.*
!.env.example